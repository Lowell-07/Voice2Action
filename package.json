{
  "name": "voice2action",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.x",
  "scripts": {
    "preinstall": "node -e \"const v=process.versions.node.split('.').map(Number); if (v[0]<20) process.exit(1);\"",
    "clean": "node -e \"const fs=require('fs'); const targets=['.next','node_modules','package-lock.json']; for (const t of targets) { if (fs.existsSync(t)) fs.rmSync(t,{recursive:true,force:true}); }\"",
    "audit:prod": "npm audit --omit=dev",
    "depcheck": "depcheck --json",
    "dev": "next dev -p 9002",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm test -- --runInBand && npm run build",
    "typecheck:watch": "tsc --noEmit --watch",
    "test:watch": "jest --watch",
    "test": "jest"
  },
  "engines": {
  "node": "20.x"
},
